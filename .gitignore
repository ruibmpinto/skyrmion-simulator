# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# macOS and editor cruft
.DS_Store
*~
*.swp

# Simulation output: regenerated by the run and analysis scripts
output/

# C++ build tree and clangd index (regenerated; do not track)
build/
.cache/
compile_commands.json

# LaTeX intermediates
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.bbl
*.blg

# Generated C++ API documentation
docs/doxygen/

# Compiled reports: rebuilt from the .tex sources in docs/
docs/*.pdf
docs/benchmarks/benchmarks.pdf
docs/stochastic_llgs/stochastic_llgs.pdf

# Reference literature: third-party copyrighted PDFs and datasets, kept
# locally but never committed
refs/

# Manuscript sources: tracked in the manuscript repository, not here
_paper*/

# Local agent and editor configuration
.claude/
.vscode/

# Local working notes and cluster run logs: kept on disk, never published
tasks/
CLUSTER_RUNS.md
